# Configuración de conexión a MySQL 8.0 para SIACC
# Copia este archivo como `.env` y completa las contraseñas locales.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bd_asentamientos

# Contraseña común para los usuarios de rol MySQL (siacc_lector, siacc_capturista, siacc_admin)
SIACC_ROLE_PASSWORD=
